{
  "name": "decision-ledger",
  "displayName": "Decision Ledger",
  "description": "Turns your AI agent conversations into grounded, ordered decision records in a git-style tree. Code passes straight through.",
  "version": "0.2.0",
  "publisher": "decision-ledger",
  "license": "MIT",
  "workspaces": [
    "engine"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./out/src/extension.js",
  "bin": {
    "ledger": "./out/src/cli.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "chatParticipants": [
      {
        "id": "decision-ledger.ledger",
        "name": "ledger",
        "fullName": "Decision Ledger",
        "description": "Ask the agent. You get the code and the decisions, not the essay.",
        "isSticky": true,
        "commands": [
          {
            "name": "state",
            "description": "Show active decisions at HEAD"
          },
          {
            "name": "log",
            "description": "Show recent nodes"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ledger",
          "title": "Decision Ledger",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ledger": [
        {
          "type": "webview",
          "id": "ledger.filter",
          "name": "Filter",
          "when": "ledger.filterVisible"
        },
        {
          "id": "ledger.tree",
          "name": "Decisions"
        },
        {
          "type": "webview",
          "id": "ledger.panel",
          "name": "Live Session"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ledger.tree",
        "contents": "No decisions yet.\n\nChat with **@ledger** in the Chat view, or run Claude Code in this workspace. Decisions show up here as ordered nodes.\n\n[Set Anthropic API Key](command:ledger.setApiKey) or [Set Vertex AI (Gemini) API Key](command:ledger.setGeminiApiKey) (optional, otherwise Copilot models are used)",
        "when": "!ledger.filterActive"
      },
      {
        "view": "ledger.tree",
        "when": "ledger.filterActive",
        "contents": "No decisions match the grade filter.\n\n[Reset Grade Filter](command:ledger.resetFilter)"
      }
    ],
    "commands": [
      {
        "command": "ledger.refresh",
        "title": "Refresh",
        "category": "Ledger",
        "icon": "$(refresh)"
      },
      {
        "command": "ledger.showCurrent",
        "title": "Show Current Decisions",
        "category": "Ledger",
        "icon": "$(list-flat)"
      },
      {
        "command": "ledger.showState",
        "title": "Show State at Node",
        "category": "Ledger"
      },
      {
        "command": "ledger.diffParent",
        "title": "Diff with Parent",
        "category": "Ledger"
      },
      {
        "command": "ledger.branchHere",
        "title": "Create Branch Here",
        "category": "Ledger"
      },
      {
        "command": "ledger.checkout",
        "title": "Switch Branch",
        "category": "Ledger",
        "icon": "$(git-branch)"
      },
      {
        "command": "ledger.setApiKey",
        "title": "Set Anthropic API Key",
        "category": "Ledger"
      },
      {
        "command": "ledger.setGeminiApiKey",
        "title": "Set Vertex AI (Gemini) API Key",
        "category": "Ledger"
      },
      {
        "command": "ledger.editParameters",
        "title": "Edit Decision Parameters",
        "category": "Ledger"
      },
      {
        "command": "ledger.toggleAgentWatch",
        "title": "Toggle Agent Watching",
        "category": "Ledger"
      },
      {
        "command": "ledger.openRecord",
        "title": "Open Decision Source",
        "category": "Ledger"
      },
      {
        "command": "ledger.showText",
        "title": "Show Text",
        "category": "Ledger"
      },
      {
        "command": "ledger.toggleFilter",
        "title": "Show or Hide Grade Filter",
        "category": "Ledger",
        "icon": "$(filter)"
      },
      {
        "command": "ledger.toggleFilterNarrowed",
        "title": "Show or Hide Grade Filter (filtered)",
        "category": "Ledger",
        "icon": "$(filter-filled)"
      },
      {
        "command": "ledger.resetFilter",
        "title": "Reset Grade Filter",
        "category": "Ledger"
      },
      {
        "command": "ledger.chooseSession",
        "title": "Switch Session",
        "category": "Ledger",
        "icon": "$(list-selection)"
      },
      {
        "command": "ledger.followLatestSession",
        "title": "Follow Latest Session",
        "category": "Ledger",
        "icon": "$(pin)"
      },
      {
        "command": "ledger.setUpModel",
        "title": "Set Up a Model",
        "category": "Ledger"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ledger.toggleFilter",
          "when": "view == ledger.tree && !ledger.filterActive",
          "group": "navigation@0"
        },
        {
          "command": "ledger.toggleFilterNarrowed",
          "when": "view == ledger.tree && ledger.filterActive",
          "group": "navigation@0"
        },
        {
          "command": "ledger.showCurrent",
          "when": "view == ledger.tree",
          "group": "navigation@1"
        },
        {
          "command": "ledger.checkout",
          "when": "view == ledger.tree",
          "group": "navigation@2"
        },
        {
          "command": "ledger.refresh",
          "when": "view == ledger.tree",
          "group": "navigation@3"
        },
        {
          "command": "ledger.chooseSession",
          "when": "view == ledger.panel",
          "group": "navigation@1"
        },
        {
          "command": "ledger.followLatestSession",
          "when": "view == ledger.panel",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "ledger.showState",
          "when": "view == ledger.tree && viewItem == node",
          "group": "1@1"
        },
        {
          "command": "ledger.diffParent",
          "when": "view == ledger.tree && viewItem == node",
          "group": "1@2"
        },
        {
          "command": "ledger.branchHere",
          "when": "view == ledger.tree && viewItem == node",
          "group": "2@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ledger.openRecord",
          "when": "false"
        },
        {
          "command": "ledger.showText",
          "when": "false"
        },
        {
          "command": "ledger.toggleFilterNarrowed",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Decision Ledger",
      "properties": {
        "ledger.engine.provider": {
          "type": "string",
          "enum": [
            "auto",
            "vscode",
            "anthropic",
            "gemini"
          ],
          "default": "auto",
          "description": "Model used to extract decisions. auto = Anthropic if its API key is set, else Gemini if its key is set, otherwise a VS Code language model (e.g. Copilot)."
        },
        "ledger.engine.anthropicModel": {
          "type": "string",
          "default": "claude-haiku-5-5"
        },
        "ledger.engine.geminiModel": {
          "type": "string",
          "default": "gemini-3.8-flash",
          "description": "Gemini model used through Vertex AI express mode."
        },
        "ledger.engine.vscodeModelFamily": {
          "type": "string",
          "default": "",
          "description": "Optional VS Code model family to use for extraction (e.g. gpt-4o). Empty = same model as the chat."
        },
        "ledger.agents.watchClaudeCode": {
          "type": "boolean",
          "default": true,
          "description": "Turn Claude Code sessions in this workspace into decision records."
        },
        "ledger.agents.claudeProjectsDir": {
          "type": "string",
          "default": "",
          "description": "Override ~/.claude/projects."
        },
        "ledger.agents.idleSeconds": {
          "type": "number",
          "default": 20,
          "description": "Process an agent's new turns once it has been quiet this long."
        },
        "ledger.agents.pollSeconds": {
          "type": "number",
          "default": 5
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run clean && tsc -p . && tsc -p tsconfig.webview.json && node scripts/copy-webview-assets.mjs",
    "test": "npm run compile && node --test out/test/*.test.js && npm test -w engine",
    "package": "npm run compile && vsce package --no-dependencies",
    "clean": "node scripts/clean.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://example.invalid/decision-ledger"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^5.9.3"
  }
}
